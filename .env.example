# Server configuration
PORT=3000
SITE_URL=http://localhost:3000

# Supabase — keep the service role key server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend notification email
RESEND_API_KEY=re_your_api_key
PRACTICE_EMAIL=hello@theinneratelier.com
FROM_EMAIL=The Inner Atelier <waitlist@your-verified-domain.com>

# A long random value used when hashing visitor IP addresses
RATE_LIMIT_SALT=replace-with-a-long-random-secret
