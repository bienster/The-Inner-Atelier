# Server configuration
PORT=3000
SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase - keep both keys server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend notification and applicant confirmation emails
RESEND_API_KEY=re_your_api_key
PRACTICE_EMAIL=hello@theinneratelier.com
FROM_EMAIL=The Inner Atelier <waitlist@your-verified-domain.com>

# Use a long, unique random value in production
RATE_LIMIT_SALT=replace-with-a-long-random-secret
